---
// Feature cards from src/data/features.ts. Every value is rendered as text, never as HTML: the
// catalog's wording comes from another repo.
import { Icon } from 'astro-icon/components';
import NewBadge from '~/components/ui/NewBadge.astro';
import type { FeatureCard } from '~/data/features';

export interface Props {
  items: FeatureCard[];
  /** 'short' for the homepage, 'detail' for /features/. */
  needs?: 'short' | 'detail';
}

const { items, needs = 'short' } = Astro.props;
---

{items.length > 0 && (
  <ul role="list" class="grid mx-auto gap-8 md:gap-y-12 sm:grid-cols-2" data-feature-grid>
    {items.map((card) => {
      const lines = needs === 'detail' ? card.needsDetail : card.needs;
      return (
        <li
          class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          data-feature-card={card.slug}
        >
          <div class="flex flex-row max-w-md">
            <div class="flex justify-center">
              <Icon
                name={card.icon}
                class="w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0 text-white bg-primary rounded-full"
              />
            </div>
            <div class="mt-0.5">
              <h3 class="text-xl font-bold md:text-[1.3rem]/7">
                {card.url ? (
                  <a href={card.url} class="hover:underline underline-offset-4">
                    {card.title}
                  </a>
                ) : (
                  card.title
                )}
              </h3>
              {card.newIn && (
                <p class="mt-2" data-feature-new>
                  <NewBadge version={card.newIn} />
                </p>
              )}
              <p class="mt-3 text-muted">{card.pitch}</p>
              {lines.length > 0 && (
                <ul role="list" class="mt-3 space-y-1 text-sm font-medium" data-feature-needs>
                  {lines.map((line) =>
                    line.href ? (
                      <li>
                        <a href={line.href} class="text-accent underline underline-offset-4 hover:no-underline">
                          {line.text}
                        </a>
                      </li>
                    ) : (
                      <li class="text-muted">{line.text}</li>
                    )
                  )}
                </ul>
              )}
            </div>
          </div>
        </li>
      );
    })}
  </ul>
)}
