---
import merge from 'lodash.merge';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages, type OpenGraph } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

// The SEO tags this site uses: title, description, robots, canonical, Open Graph and the
// Twitter card. Defaults come from src/config.yaml (METADATA), then each page's props win.
interface SeoProps {
  title?: string;
  titleTemplate?: string;
  noindex?: boolean;
  nofollow?: boolean;
  description?: string;
  canonical?: string;
  openGraph?: OpenGraph;
  twitter?: { cardType?: string; site?: string; handle?: string };
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const seoProps: SeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: I18N?.language || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);

const og = await adaptOpenGraphImages(seoProps.openGraph, Astro.site);
const fullTitle = seoProps.title && (seoProps.titleTemplate ?? '%s').replace('%s', seoProps.title);
const robotsContent = [
  ...(seoProps.noindex === undefined ? [] : [seoProps.noindex ? 'noindex' : 'index']),
  ...(seoProps.nofollow === undefined ? [] : [seoProps.nofollow ? 'nofollow' : 'follow']),
].join(',');
const ogTitle = og.title || seoProps.title;
const ogDescription = og.description || seoProps.description;
const tw = seoProps.twitter ?? {};
---

{fullTitle && <title>{fullTitle}</title>}
{seoProps.description && <meta name="description" content={seoProps.description} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
{seoProps.canonical && <link rel="canonical" href={seoProps.canonical} />}

{ogTitle && <meta property="og:title" content={ogTitle} />}
{ogDescription && <meta property="og:description" content={ogDescription} />}
{og.url && <meta property="og:url" content={og.url} />}
{og.type && <meta property="og:type" content={og.type} />}
{og.images?.map((image) => (
  <>
    <meta property="og:image" content={image.url} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
  </>
))}
{og.locale && <meta property="og:locale" content={og.locale} />}
{og.site_name && <meta property="og:site_name" content={og.site_name} />}

{tw.cardType && <meta name="twitter:card" content={tw.cardType} />}
{tw.site && <meta name="twitter:site" content={tw.site} />}
{tw.handle && <meta name="twitter:creator" content={tw.handle} />}
