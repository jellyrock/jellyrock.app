---
// Scroll-reveal for elements styled with the `intersect:` Tailwind variant
// (tailwind.config.js), inspired by https://github.com/heidkaemper/tailwindcss-intersect.
// A processed (bundled) script, not `is:inline`: the site's CSP is `script-src 'self'`
// (ADR-0006), which blocks inline scripts in production.
---

<script>
  const selectors = [
    '[class*=" intersect:"]',
    '[class*=":intersect:"]',
    '[class^="intersect:"]',
    '[class="intersect"]',
    '[class*=" intersect "]',
    '[class^="intersect "]',
    '[class$=" intersect"]',
  ];

  const getThreshold = (element: Element): number => {
    if (element.classList.contains('intersect-full')) return 0.99;
    if (element.classList.contains('intersect-half')) return 0.5;
    if (element.classList.contains('intersect-quarter')) return 0.25;
    return 0;
  };

  let observer: IntersectionObserver | undefined;

  const start = () => {
    observer?.disconnect();

    const elements = Array.from(document.querySelectorAll<HTMLElement>(selectors.join(',')));
    const thresholds = new WeakMap<Element, number>();
    const delayBetweenAnimations = 0;
    let animationCounter = 0;

    elements.forEach((el) => {
      thresholds.set(el, getThreshold(el));
      // This script is deferred, so on a slow connection the page paints first and the
      // elements on screen have already started their fade. Re-hiding those would make them
      // flicker; only elements still below the fold wait to be revealed on scroll.
      if (el.getBoundingClientRect().top >= window.innerHeight) {
        el.setAttribute('no-intersect', '');
      }
    });

    const callback: IntersectionObserverCallback = (entries, obs) => {
      entries.forEach((entry) => {
        requestAnimationFrame(() => {
          const target = entry.target as HTMLElement;

          if (target.classList.contains('intersect-no-queue')) {
            if (entry.isIntersecting) {
              target.removeAttribute('no-intersect');
              if (target.classList.contains('intersect-once')) {
                obs.unobserve(target);
              }
            } else {
              target.setAttribute('no-intersect', '');
            }
            return;
          }

          if (entry.intersectionRatio >= (thresholds.get(target) ?? 0)) {
            if (!target.hasAttribute('data-animated')) {
              target.removeAttribute('no-intersect');
              target.setAttribute('data-animated', 'true');

              const delay = animationCounter * delayBetweenAnimations;
              animationCounter++;

              target.style.transitionDelay = `${delay}ms`;
              target.style.animationDelay = `${delay}ms`;

              if (target.classList.contains('intersect-once')) {
                obs.unobserve(target);
              }
            }
          } else {
            target.setAttribute('no-intersect', '');
            target.removeAttribute('data-animated');
            target.style.transitionDelay = '';
            target.style.animationDelay = '';

            animationCounter = 0;
          }
        });
      });
    };

    observer = new IntersectionObserver(callback, { threshold: [0, 0.25, 0.5, 0.99] });
    elements.forEach((el) => observer?.observe(el));
  };

  // Fires on the first load and after every ClientRouter navigation.
  document.addEventListener('astro:page-load', start);
</script>
