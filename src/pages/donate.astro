---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Donate',
};
---

<Layout metadata={metadata}>
  <HeroText>
    <Fragment slot="title">
      Support <span class="text-accent">JellyRock</span>
    </Fragment>

    <Fragment slot="subtitle">
      Hey, I'm Charles 👋 I build JellyRock on my own, in my spare time. When someone sponsors it, it makes my day. I
      appreciate every single one of you.
    </Fragment>
  </HeroText>

  <section class="px-4 pb-12">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="https://buymeacoffee.com/cewert" target="_blank" variant="primary" icon="tabler:coffee">
          Buy me a coffee
        </Button>
        <Button href="https://github.com/sponsors/cewert" target="_blank" variant="secondary" icon="tabler:heart">
          Sponsor on GitHub
        </Button>
      </div>

      <p class="mt-8" style="color: var(--jr-text-secondary)">
        The money goes back into the project: the Roku devices I test on, the domain and email, and the AI coding tools
        that help me get more done in the time I have.
      </p>
    </div>
  </section>

  <Features2
    title="Other ways to help"
    subtitle="Not able to give? Totally fine. There are lots of other ways to help."
    columns={2}
    items={[
      {
        title: 'Tell a friend',
        description: 'Know someone with a Roku and a Jellyfin server? Point them to JellyRock.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Star JellyRock on GitHub',
        description:
          '<a href="https://github.com/jellyrock/jellyrock" target="_blank" class="text-accent underline">github.com/jellyrock/jellyrock</a>',
        icon: 'tabler:star',
      },
      {
        title: 'Report a bug or suggest a feature',
        description:
          '<a href="https://github.com/jellyrock/jellyrock/issues/new/choose" target="_blank" class="text-accent underline">Open an issue on GitHub</a>',
        icon: 'tabler:bug',
      },
      {
        title: 'Translate JellyRock',
        description:
          'Help translate the app into your language on <a href="https://translate.jellyrock.app/projects/jellyrock/" target="_blank" class="text-accent underline">Weblate</a>.',
        icon: 'tabler:language',
      },
      {
        title: 'Answer questions',
        description:
          'Help other people in <a href="https://github.com/jellyrock/jellyrock/discussions" target="_blank" class="text-accent underline">GitHub Discussions</a>.',
        icon: 'tabler:messages',
      },
      {
        title: 'Improve the docs',
        description:
          'Every page on <a href="https://docs.jellyrock.app/" target="_blank" class="text-accent underline">docs.jellyrock.app</a> has an "Edit page" link.',
        icon: 'tabler:file-text',
      },
    ]}
  />

  <section class="px-4 pb-20">
    <div class="max-w-3xl mx-auto text-center text-sm" style="color: var(--jr-text-secondary)">
      <p>
        Donations go straight to me through Buy Me a Coffee or GitHub Sponsors. JellyRock itself doesn't collect or hold
        any money.
      </p>
      <p class="mt-4">Thanks for using JellyRock! I hope it's a pleasure to use.</p>
    </div>
  </section>
</Layout>
