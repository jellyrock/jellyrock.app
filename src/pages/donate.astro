---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Donate',
};
---

<Layout metadata={metadata}>
  <HeroText>
    <Fragment slot="title">
      Support <span class="text-accent">JellyRock</span>
    </Fragment>

    <!-- prettier-ignore -->
    <Fragment slot="subtitle">
      Hiya, I'm Charlie 👋 JellyRock is an open-source Jellyfin client for Roku. I build it on my own, in my spare time:
      the <a href="/" class="text-accent underline">app</a>, its
      <a href="/companion-plugin/" class="text-accent underline">companion server plugin</a> and the
      <a href="https://docs.jellyrock.app" target="_blank" class="text-accent underline">docs</a>. My focus is making it
      stable and fast, playing your files in their original quality whenever your Roku can, and adding the features
      people ask for most, without making it harder to use.
    </Fragment>
  </HeroText>

  <section class="px-4 pb-12">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="https://buymeacoffee.com/cewert" target="_blank" variant="primary" icon="tabler:coffee">
          Buy me a coffee
        </Button>
        <Button href="https://github.com/sponsors/cewert" target="_blank" variant="secondary" icon="tabler:heart">
          Sponsor on GitHub
        </Button>
      </div>

      <p class="mt-8" style="color: var(--jr-text-secondary)">
        Sponsorships go straight back into the project: the Roku devices I test on, the domain and email, and the AI
        coding tools that help me get more done in the time I have. And honestly, it's really encouraging to know people
        like it that much.
      </p>
    </div>
  </section>

  <Features2
    title="Other ways to help"
    subtitle="Not able to give? These help just as much."
    columns={2}
    items={[
      {
        title: 'Tell a friend',
        description: 'Know someone with a Roku and a Jellyfin server? Point them to JellyRock.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Star JellyRock on GitHub',
        description:
          '<a href="https://github.com/jellyrock/jellyrock" target="_blank" class="text-accent underline">github.com/jellyrock/jellyrock</a>',
        icon: 'tabler:star',
      },
      {
        title: 'Rate JellyRock on Roku',
        description:
          'Rate it on the <a href="https://channelstore.roku.com/details/232f9e82db11ce628e3fe7e01382a330:a85d6e9e520567806e8dae1c0cabadd5/jellyrock" target="_blank" class="text-accent underline">Roku Channel Store</a> website: sign in to your Roku account, then click the stars at the top of the page. You need JellyRock installed, and it can\'t be done from the TV.',
        icon: 'tabler:thumb-up',
      },
      {
        title: 'Report a bug or suggest a feature',
        description:
          '<a href="https://github.com/jellyrock/jellyrock/issues/new/choose" target="_blank" class="text-accent underline">Open an issue on GitHub</a>',
        icon: 'tabler:bug',
      },
      {
        title: 'Translate JellyRock',
        description:
          'Help translate the app into your language on <a href="https://translate.jellyrock.app/projects/jellyrock/" target="_blank" class="text-accent underline">Weblate</a>.',
        icon: 'tabler:language',
      },
      {
        title: 'Contribute code or docs',
        description:
          'Start with the <a href="https://github.com/jellyrock/.github/blob/main/CONTRIBUTING.md" target="_blank" class="text-accent underline">contributing guide</a>.',
        icon: 'tabler:git-pull-request',
      },
    ]}
  />

  <section class="px-4 pb-20">
    <div class="max-w-3xl mx-auto text-center text-sm" style="color: var(--jr-text-secondary)">
      <p>
        Donations go straight to me through Buy Me a Coffee or GitHub Sponsors. JellyRock itself doesn't collect or hold
        any money.
      </p>
      <p class="mt-4">Thanks for using JellyRock! I hope you enjoy it as much as I do.</p>
    </div>
  </section>
</Layout>
