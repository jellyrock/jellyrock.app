---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FeatureSection from '~/components/widgets/FeatureSection.astro';
import { siteFeatures } from '~/data/site-features';

const metadata = {
  title: 'Features',
};

const { serverRange } = siteFeatures;
const { languages } = siteFeatures.app;
---

<Layout metadata={metadata}>
  <HeroText>
    <Fragment slot="title">
      All <span class="text-accent">Features</span>
    </Fragment>

    <Fragment slot="subtitle">
      Everything JellyRock does. It comes in <span data-catalog-text>{languages}</span> languages and works with{' '}
      <span class="whitespace-nowrap" data-catalog-text>{`${serverRange}.`}</span>
    </Fragment>
  </HeroText>

  <FeatureSection id="all-features" items={siteFeatures.all} needs="detail" />
</Layout>
