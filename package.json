{
  "name": "jellyrock.app",
  "version": "1.0.0",
  "description": "Marketing and landing site for JellyRock, a Jellyfin client for Roku.",
  "license": "MIT",
  "author": "Charles Ewert",
  "homepage": "https://jellyrock.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellyrock/jellyrock.app.git"
  },
  "bugs": {
    "url": "https://github.com/jellyrock/jellyrock.app/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "scripts/playwright-docker.sh playwright test",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "scripts/playwright-docker.sh playwright test --grep @visual",
    "test:visual:update": "scripts/playwright-docker.sh playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "astro": "7.4.2",
    "astro-icon": "1.2.0",
    "limax": "4.2.3",
    "lodash.merge": "4.6.2",
    "medium-zoom": "1.1.0",
    "unpic": "4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@iconify-json/tabler": "1.2.42",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/lodash.merge": "4.6.9",
    "@typescript-eslint/parser": "8.72.0",
    "astro-compress": "2.4.3",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "js-yaml": "5.5.0",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "reading-time": "1.5.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unist-util-visit": "5.2.0"
  }
}
